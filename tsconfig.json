{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["plugins/your-call/**/*.js", "test/**/*.js"],
  "exclude": ["test/fixtures"]
}
